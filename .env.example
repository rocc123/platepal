# Public browser vars. Copy to .env — never commit real values.
# From Supabase: Connect, or Project Settings → API Keys.
# Vercel Marketplace also injects NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY; the Vite build maps those automatically.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Food search uses USDA DEMO_KEY without this.
VITE_USDA_API_KEY=
